{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Picell3D",
  "version": "0.1.0",
  "identifier": "io.github.taalaydev.picell3d",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Picell3D",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "GraphicsAndDesign",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "bundleName": "Picell3D",
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "15.0"
    },
    "publisher": "TaalayDev",
    "copyright": "© 2026 TaalayDev"
  }
}
